# --- LLM provider ---
# mock (default, no key needed) | groq | vertex
LLM_PROVIDER=mock
GROQ_API_KEY=

# --- GCP (only needed if USE_REAL_GCP=true) ---
USE_REAL_GCP=false
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BQ_DATASET=supply_chain_copilot
PUBSUB_TOPIC=agent-events

# --- Mock ERP ---
ERP_BASE_URL=http://localhost:8001

# --- Guardrails ---
CONFIDENCE_THRESHOLD=0.55

# --- Audit ---
AUDIT_DB_PATH=./audit_trail.db
